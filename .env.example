# Copy to .env and fill in the real value.
#
# PUBLIC_ - Astro inlines this into the client bundle at build time, so it's not secret;
# it's just the base URL of the ask-my-site backend (see AskAssistant.astro). CORS on that
# service is what actually restricts who can call it, locked to this site's origin.
PUBLIC_ASK_MY_SITE_API_URL=https://ask-my-site-xxxxx-ew.a.run.app
