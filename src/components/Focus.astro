---
import { focusAreas } from "../data/profile";
---

<section id="focus" class="scroll-mt-20 border-b border-stone-200 bg-white">
	<div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
		<h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">What I do</h2>
		<p class="mt-3 max-w-2xl font-serif text-2xl leading-snug text-stone-900 sm:text-3xl">
			Three things, mostly — and they keep turning out to be the same problem from different angles.
		</p>

		<div class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
			{
				focusAreas.map((area, index) => (
					<article class="rounded-2xl border border-stone-200 bg-stone-50/60 p-6 transition-colors hover:border-stone-300 sm:p-7">
						<span class="font-serif text-sm text-stone-300">{String(index + 1).padStart(2, "0")}</span>
						<h3 class="mt-2 font-serif text-lg font-semibold text-stone-900">{area.title}</h3>
						<p class="mt-2.5 text-sm leading-relaxed text-stone-600">{area.description}</p>
						<ul class="mt-4 flex flex-wrap gap-1.5">
							{area.tags.map((tag) => (
								<li class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-stone-500 ring-1 ring-stone-200">
									{tag}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
