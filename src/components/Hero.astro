---
import { profile } from "../data/profile";
---

<section class="mx-auto max-w-3xl px-6 pb-20 pt-16 sm:pt-24">
	<p class="mb-4 text-sm font-medium uppercase tracking-widest text-emerald-700">
		{profile.role}
	</p>
	<h1 class="font-serif text-4xl font-semibold leading-tight text-stone-900 sm:text-5xl">
		{profile.name}
	</h1>
	<p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-600">
		{profile.tagline}
	</p>
	<div class="mt-8 flex flex-wrap items-center gap-4">
		<a
			href={`mailto:${profile.email}`}
			class="rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-stone-50 transition-colors hover:bg-stone-700"
		>
			Get in touch
		</a>
		<a
			href={profile.socials.github}
			target="_blank"
			rel="noreferrer"
			class="rounded-full border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:border-stone-400 hover:text-stone-900"
		>
			GitHub
		</a>
		<a
			href={profile.socials.linkedin}
			target="_blank"
			rel="noreferrer"
			class="rounded-full border border-stone-300 px-5 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:border-stone-400 hover:text-stone-900"
		>
			LinkedIn
		</a>
	</div>
</section>
