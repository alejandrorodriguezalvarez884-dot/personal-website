---
import { projects } from "../data/profile";
---

<section id="proyectos" class="mx-auto max-w-3xl scroll-mt-20 px-6 py-16">
	<h2 class="font-serif text-2xl font-semibold text-stone-900">Proyectos</h2>
	<p class="mt-2 text-sm text-stone-500">
		Selección de proyectos de GitHub, ordenados cronológicamente.
	</p>

	<div class="mt-8 space-y-5">
		{
			projects.map((project) => (
				<article class="rounded-xl border border-stone-200 bg-white p-5 transition-all hover:border-stone-300 hover:shadow-md hover:shadow-stone-200/60">
					<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
						<a
							href={project.url}
							target="_blank"
							rel="noreferrer"
							class="font-medium text-stone-900 transition-colors hover:text-emerald-700"
						>
							{project.name}
						</a>
						<div class="flex items-center gap-2">
							{project.status === "in-progress" && (
								<span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">
									En progreso
								</span>
							)}
							<span class="text-sm text-stone-400">{project.period}</span>
						</div>
					</div>

					<p class="mt-2 text-sm leading-relaxed text-stone-600">{project.description}</p>

					<ul class="mt-4 flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">
								{tag}
							</li>
						))}
					</ul>

					{project.subprojects && (
						<ul class="mt-5 space-y-3 border-t border-stone-100 pt-4">
							{project.subprojects.map((sub) => (
								<li>
									<a
										href={sub.url}
										target="_blank"
										rel="noreferrer"
										class="text-sm font-medium text-stone-800 transition-colors hover:text-emerald-700"
									>
										{sub.name}
									</a>
									<p class="text-sm leading-relaxed text-stone-500">{sub.description}</p>
								</li>
							))}
						</ul>
					)}
				</article>
			))
		}
	</div>
</section>
