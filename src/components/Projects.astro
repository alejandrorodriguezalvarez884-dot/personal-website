---
import { projects, upcomingProjects } from "../data/profile";
---

<section class="mx-auto max-w-4xl px-6 pb-16 pt-16 sm:pt-24">
	<h2 class="font-serif text-3xl font-semibold text-stone-900">Projects</h2>
	<p class="mt-2 text-base text-stone-500">
		A selection of GitHub projects, most recent first.
	</p>

	<div class="mt-10 space-y-10">
		{
			projects.map((project) => (
				<article class="overflow-hidden rounded-2xl border border-stone-200 bg-white transition-all hover:border-stone-300 hover:shadow-lg hover:shadow-stone-200/60">
					{project.image && (
						<a href={project.url} target="_blank" rel="noreferrer" class="block border-b border-stone-100 bg-stone-900">
							<img
								src={project.image}
								alt={project.imageAlt ?? project.name}
								loading="lazy"
								class="max-h-96 w-full object-contain"
							/>
						</a>
					)}

					<div class="p-6 sm:p-8">
						<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
							<a
								href={project.url}
								target="_blank"
								rel="noreferrer"
								class="font-serif text-xl font-semibold text-stone-900 transition-colors hover:text-emerald-700"
							>
								{project.name}
							</a>
							<div class="flex items-center gap-2">
								{project.status === "in-progress" && (
									<span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">
										In progress
									</span>
								)}
								<span class="text-sm text-stone-400">{project.period}</span>
							</div>
						</div>

						<p class="mt-3 text-base leading-relaxed text-stone-600">{project.description}</p>

						{project.details && (
							<div class="mt-3 space-y-3 text-sm leading-relaxed text-stone-600">
								{project.details.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						)}

						<ul class="mt-5 flex flex-wrap gap-2">
							{project.tags.map((tag) => (
								<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">
									{tag}
								</li>
							))}
						</ul>

						{project.subprojects && (
							<ul class="mt-6 space-y-3 border-t border-stone-100 pt-5">
								{project.subprojects.map((sub) => (
									<li>
										<a
											href={sub.url}
											target="_blank"
											rel="noreferrer"
											class="text-sm font-medium text-stone-800 transition-colors hover:text-emerald-700"
										>
											{sub.name}
										</a>
										<p class="text-sm leading-relaxed text-stone-500">{sub.description}</p>
									</li>
								))}
							</ul>
						)}
					</div>
				</article>
			))
		}
	</div>

	<div class="mt-14">
		<h3 class="font-serif text-xl font-semibold text-stone-900">Coming soon</h3>
		<p class="mt-2 text-sm text-stone-500">Projects in the pipeline, not started yet.</p>

		<div class="mt-6 space-y-4">
			{
				upcomingProjects.map((project) => (
					<div class="rounded-xl border border-dashed border-stone-300 bg-stone-50/60 p-5">
						<h4 class="font-medium text-stone-700">{project.name}</h4>
						<p class="mt-2 text-sm leading-relaxed text-stone-500">{project.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
