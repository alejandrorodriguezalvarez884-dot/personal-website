---
import { projects } from "../data/profile";
---

<section id="proyectos" class="mx-auto max-w-3xl scroll-mt-20 px-6 py-16">
	<h2 class="font-serif text-2xl font-semibold text-stone-900">Proyectos</h2>
	<p class="mt-2 text-sm text-stone-500">
		Selección de proyectos de GitHub. (Contenido de ejemplo — se actualizará con tus repositorios reales).
	</p>

	<div class="mt-8 grid gap-5 sm:grid-cols-2">
		{
			projects.map((project) => (
				<a
					href={project.url}
					target="_blank"
					rel="noreferrer"
					class="group rounded-xl border border-stone-200 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-md hover:shadow-stone-200/60"
				>
					<h3 class="font-medium text-stone-900 transition-colors group-hover:text-emerald-700">
						{project.name}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-stone-600">{project.description}</p>
					<ul class="mt-4 flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">
								{tag}
							</li>
						))}
					</ul>
				</a>
			))
		}
	</div>
</section>
