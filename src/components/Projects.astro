---
import { projects, upcomingProjects } from "../data/profile";
---

<section class="mx-auto max-w-4xl px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20">
	<h1 class="font-serif text-3xl font-semibold text-stone-900 sm:text-5xl">Projects</h1>
	<p class="mt-3 max-w-xl text-base leading-relaxed text-stone-500 sm:text-lg">
		A selection of things I've built, most recent first. Each one expands into how it actually works.
	</p>

	<div class="mt-10 space-y-6 sm:mt-14 sm:space-y-10">
		{
			projects.map((project) => (
				<article class="overflow-hidden rounded-2xl border border-stone-200 bg-white transition-colors hover:border-stone-300">
					{project.image && (
						<a href={project.url} target="_blank" rel="noreferrer" class="block border-b border-stone-100 bg-stone-950">
							<img
								src={project.image}
								alt={project.imageAlt ?? project.name}
								loading="lazy"
								class="max-h-56 w-full object-contain sm:max-h-96"
							/>
						</a>
					)}

					<div class="p-5 sm:p-8">
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
							{project.status === "in-progress" && (
								<span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">
									In progress
								</span>
							)}
							<span class="text-xs text-stone-400 sm:text-sm">{project.period}</span>
						</div>

						<h2 class="mt-2">
							<a
								href={project.url}
								target="_blank"
								rel="noreferrer"
								class="font-serif text-xl font-semibold text-stone-900 transition-colors hover:text-emerald-700 sm:text-2xl"
							>
								{project.name}
							</a>
						</h2>

						<p class="mt-3 text-base leading-relaxed text-stone-600">{project.description}</p>

						<ul class="mt-5 flex flex-wrap gap-1.5 sm:gap-2">
							{project.tags.map((tag) => (
								<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">{tag}</li>
							))}
						</ul>

						{/* The long-form write-up is the part that used to make this page a wall of
						    text - it stays one tap away instead of being the default. */}
						{project.details && (
							<details class="group mt-5 border-t border-stone-100 pt-4">
								<summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-stone-700 transition-colors hover:text-emerald-700 [&::-webkit-details-marker]:hidden">
									<span class="group-open:hidden">How it works</span>
									<span class="hidden group-open:inline">Hide details</span>
									<svg
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
										class="h-4 w-4 text-stone-400 transition-transform group-open:rotate-180"
									>
										<path
											fill-rule="evenodd"
											d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z"
											clip-rule="evenodd"
										/>
									</svg>
								</summary>
								<div class="mt-3 space-y-3 text-sm leading-relaxed text-stone-600">
									{project.details.map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</div>
							</details>
						)}

						{project.subprojects && (
							<details class="group mt-4 border-t border-stone-100 pt-4">
								<summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-stone-700 transition-colors hover:text-emerald-700 [&::-webkit-details-marker]:hidden">
									{project.subprojects.length} repositories
									<svg
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
										class="h-4 w-4 text-stone-400 transition-transform group-open:rotate-180"
									>
										<path
											fill-rule="evenodd"
											d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z"
											clip-rule="evenodd"
										/>
									</svg>
								</summary>
								<ul class="mt-3 space-y-3">
									{project.subprojects.map((sub) => (
										<li>
											<a
												href={sub.url}
												target="_blank"
												rel="noreferrer"
												class="text-sm font-medium text-stone-800 underline-offset-2 transition-colors hover:text-emerald-700 hover:underline"
											>
												{sub.name}
											</a>
											<p class="text-sm leading-relaxed text-stone-500">{sub.description}</p>
										</li>
									))}
								</ul>
							</details>
						)}

						<a
							href={project.url}
							target="_blank"
							rel="noreferrer"
							class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 underline-offset-4 hover:underline"
						>
							View on GitHub
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
								<path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
								<path
									d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"
								></path>
							</svg>
						</a>
					</div>
				</article>
			))
		}
	</div>

	<div class="mt-14 sm:mt-20">
		<h2 class="font-serif text-xl font-semibold text-stone-900 sm:text-2xl">Coming soon</h2>
		<p class="mt-2 text-sm text-stone-500">Projects in the pipeline, not started yet.</p>

		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			{
				upcomingProjects.map((project) => (
					<div class="rounded-xl border border-dashed border-stone-300 bg-white/60 p-5">
						<h3 class="font-medium text-stone-700">{project.name}</h3>
						<p class="mt-2 text-sm leading-relaxed text-stone-500">{project.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
