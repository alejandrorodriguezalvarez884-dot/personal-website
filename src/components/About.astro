---
import { profile, experience, education, certifications, skillCategories } from "../data/profile";
---

<section id="about" class="scroll-mt-20 border-b border-stone-200 bg-white">
	<div class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
		<h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">About</h2>

		<div class="mt-6 space-y-4 text-base leading-relaxed text-stone-600 sm:text-lg">
			{profile.bio.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<div class="mt-10 space-y-6 sm:mt-12">
			{
				skillCategories.map((group) => (
					<div class="sm:flex sm:items-baseline sm:gap-6">
						<h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-400 sm:w-28 sm:shrink-0">
							{group.category}
						</h3>
						<ul class="mt-2 flex flex-wrap gap-1.5 sm:mt-0 sm:flex-1 sm:gap-2">
							{group.items.map((skill) => (
								<li class="rounded-full border border-stone-200 px-3 py-1 text-sm text-stone-700">{skill}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-14">
			<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
				<h3 class="font-serif text-xl font-semibold text-stone-900">Experience</h3>
				<p class="text-xs text-stone-400">Tap any role for the detail</p>
			</div>

			<ol class="mt-5 space-y-2">
				{
					experience.map((item, index) => (
						<li>
							{/* Collapsed by default (the most recent role opens on load) so the page stays
							    scannable; everything is still in the DOM for search and for crawlers. */}
							<details class="group rounded-xl border border-stone-200 open:border-stone-300 open:bg-stone-50/60" open={index === 0}>
								<summary class="flex cursor-pointer list-none items-start gap-3 p-4 [&::-webkit-details-marker]:hidden">
									<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-emerald-600 group-open:bg-emerald-700" />
									<span class="min-w-0 flex-1">
										<span class="block font-medium text-stone-900">{item.role}</span>
										<span class="mt-0.5 block text-sm text-stone-500">
											{item.company}
											{item.client && ` · client: ${item.client}`}
										</span>
										<span class="mt-1 block text-xs text-stone-400">
											{item.period} · {item.location}
										</span>
									</span>
									<svg
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
										class="mt-1 h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-180"
									>
										<path
											fill-rule="evenodd"
											d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z"
											clip-rule="evenodd"
										/>
									</svg>
								</summary>

								<div class="space-y-4 border-t border-stone-200 px-4 py-4">
									{/* The summary already names the company in plain text; this repeats it only
									    because a link inside a <summary> fights with the toggle. */}
									<p class="text-xs text-stone-400">
										{item.companyUrl ? (
											<a
												href={item.companyUrl}
												target="_blank"
												rel="noreferrer"
												class="underline underline-offset-2 transition-colors hover:text-emerald-700"
											>
												{item.company}
											</a>
										) : (
											item.company
										)}
										{item.client && (
											<>
												{" — client: "}
												{item.clientUrl ? (
													<a
														href={item.clientUrl}
														target="_blank"
														rel="noreferrer"
														class="underline underline-offset-2 transition-colors hover:text-emerald-700"
													>
														{item.client}
													</a>
												) : (
													item.client
												)}
											</>
										)}
									</p>

									{item.bullets && item.bullets.length > 0 && (
										<ul class="list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-stone-600">
											{item.bullets.map((bullet) => (
												<li>{bullet}</li>
											))}
										</ul>
									)}

									{item.tech && (
										<ul class="flex flex-wrap gap-1.5">
											{item.tech.map((tech) => (
												<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">{tech}</li>
											))}
										</ul>
									)}

									{item.subroles && (
										<ol class="space-y-4 border-l border-stone-200 pl-4">
											{item.subroles.map((sub) => (
												<li>
													<h5 class="text-sm font-medium text-stone-800">{sub.title}</h5>
													<p class="text-xs text-stone-400">{sub.period}</p>
													{sub.bullets.length > 0 && (
														<ul class="mt-1.5 list-disc space-y-1 pl-4 text-sm leading-relaxed text-stone-600">
															{sub.bullets.map((bullet) => (
																<li>{bullet}</li>
															))}
														</ul>
													)}
													{sub.tech && (
														<ul class="mt-2 flex flex-wrap gap-1.5">
															{sub.tech.map((tech) => (
																<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">
																	{tech}
																</li>
															))}
														</ul>
													)}
												</li>
											))}
										</ol>
									)}
								</div>
							</details>
						</li>
					))
				}
			</ol>
		</div>

		<div class="mt-14 grid gap-10 sm:grid-cols-2 sm:gap-8">
			<div>
				<h3 class="font-serif text-xl font-semibold text-stone-900">Education</h3>
				<ul class="mt-5 space-y-5">
					{
						education.map((item) => (
							<li>
								<h4 class="font-medium leading-snug text-stone-900">{item.degree}</h4>
								<p class="mt-1 text-sm text-stone-600">{item.institution}</p>
								<p class="text-xs text-stone-400">
									{item.period} · {item.location}
								</p>
								{item.description && <p class="mt-1.5 text-sm leading-relaxed text-stone-500">{item.description}</p>}
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="font-serif text-xl font-semibold text-stone-900">Certifications</h3>
				<ul class="mt-5 space-y-4">
					{
						certifications.map((cert) => (
							<li>
								<p class="text-sm leading-snug text-stone-700">{cert.name}</p>
								<p class="mt-1 text-xs text-stone-400">
									{cert.issuer} · {cert.year}
								</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
