---
import { ossContributions, profile } from "../data/profile";

// All PRs by this account to repos it doesn't own.
const user = profile.socials.github.split("/").pop();
const prsUrl = `https://github.com/pulls?q=is%3Apr+author%3A${user}+-user%3A${user}`;

const merged = ossContributions.filter((pr) => pr.status === "merged").length;
const repos = new Set(ossContributions.map((pr) => pr.repo)).size;
---

<section class="mx-auto max-w-4xl px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20">
	<h1 class="font-serif text-3xl font-semibold text-stone-900 sm:text-5xl">Open-source contributions</h1>
	<p class="mt-3 max-w-xl text-base leading-relaxed text-stone-500 sm:text-lg">
		Fixes and features for the libraries I build on. Most start from reading their code, not from the issue tracker.
	</p>
	<p class="mt-4 text-sm text-stone-500">
		{ossContributions.length} pull requests · {merged} merged · {repos} repositories
	</p>

	<div class="mt-10 space-y-6 sm:mt-14 sm:space-y-10">
		{
			ossContributions.map((pr) => (
				<article class="rounded-2xl border border-stone-200 bg-white p-5 transition-colors hover:border-stone-300 sm:p-8">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
						{pr.status === "merged" ? (
							<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-200">
								Merged
							</span>
						) : (
							<span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-200">
								In review
							</span>
						)}
						<span class="text-xs text-stone-400 sm:text-sm">{pr.date}</span>
						<span class="font-mono text-xs text-stone-400">{pr.diff}</span>
					</div>

					<p class="mt-3 break-words font-mono text-xs text-stone-500 sm:text-sm">
						<span class="whitespace-nowrap">{pr.repo.split("/")[0]}/</span><wbr /><span class="whitespace-nowrap">{pr.repo.split("/")[1]}<span class="text-stone-400">#{pr.number}</span></span>
					</p>
					<h2 class="mt-1">
						<a
							href={pr.url}
							target="_blank"
							rel="noreferrer"
							class="font-serif text-xl font-semibold text-stone-900 transition-colors hover:text-emerald-700 sm:text-2xl"
						>
							{pr.title}
						</a>
					</h2>

					<p class="mt-3 text-base leading-relaxed text-stone-600">{pr.description}</p>

					<ul class="mt-5 flex flex-wrap gap-1.5 sm:gap-2">
						{pr.tags.map((tag) => (
							<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">{tag}</li>
						))}
					</ul>

					<details class="group mt-5 border-t border-stone-100 pt-4">
						<summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-stone-700 transition-colors hover:text-emerald-700 [&::-webkit-details-marker]:hidden">
							<span class="group-open:hidden">What changed</span>
							<span class="hidden group-open:inline">Hide details</span>
							<svg
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
								class="h-4 w-4 text-stone-400 transition-transform group-open:rotate-180"
							>
								<path
									fill-rule="evenodd"
									d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z"
									clip-rule="evenodd"
								/>
							</svg>
						</summary>
						<div class="mt-3 space-y-3 text-sm leading-relaxed text-stone-600">
							{pr.details.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</div>
					</details>

					<a
						href={pr.url}
						target="_blank"
						rel="noreferrer"
						class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-700 underline-offset-4 hover:underline"
					>
						View pull request
						<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
							<path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
							<path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
						</svg>
					</a>
				</article>
			))
		}
	</div>

	<a
		href={prsUrl}
		target="_blank"
		rel="noreferrer"
		class="mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-stone-600 underline-offset-4 transition-colors hover:text-stone-900 hover:underline"
	>
		All my pull requests on GitHub
		<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
			<path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
			<path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
		</svg>
	</a>
</section>
