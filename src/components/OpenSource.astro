---
import { ossContributions, profile } from "../data/profile";

// All PRs by this account to repos it doesn't own.
const user = profile.socials.github.split("/").pop();
const prsUrl = `https://github.com/pulls?q=is%3Apr+author%3A${user}+-user%3A${user}`;
---

<section id="open-source" class="scroll-mt-20 border-b border-stone-200">
	<div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">Open source</h2>
				<p class="mt-3 max-w-2xl font-serif text-2xl leading-snug text-stone-900 sm:text-3xl">
					Fixes and features for the libraries I build on
				</p>
			</div>
			<a
				href={prsUrl}
				target="_blank"
				rel="noreferrer"
				class="group inline-flex items-center gap-1.5 text-sm font-medium text-stone-600 transition-colors hover:text-stone-900"
			>
				All pull requests
				<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-0.5">
					<path
						fill-rule="evenodd"
						d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
						clip-rule="evenodd"></path>
				</svg>
			</a>
		</div>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-3">
			{
				ossContributions.map((pr) => (
					<a
						href={pr.url}
						target="_blank"
						rel="noreferrer"
						class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-5 transition-all hover:border-stone-300 hover:shadow-lg hover:shadow-stone-200/60 sm:p-6"
					>
						<div class="flex items-center justify-between gap-3">
							{pr.status === "merged" ? (
								<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-200">
									Merged
								</span>
							) : (
								<span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-amber-200">
									In review
								</span>
							)}
							<span class="text-xs text-stone-400">{pr.date}</span>
						</div>
						<p class="mt-4 break-all font-mono text-xs text-stone-500">
							{pr.repo}<span class="text-stone-400">#{pr.number}</span>
						</p>
						<h3 class="mt-1.5 font-serif text-lg font-semibold leading-snug text-stone-900 transition-colors group-hover:text-emerald-700">
							{pr.title}
						</h3>
						<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{pr.description}</p>
						<ul class="mt-4 flex flex-wrap gap-1.5">
							{pr.tags.map((tag) => (
								<li class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">{tag}</li>
							))}
						</ul>
					</a>
				))
			}
		</div>
	</div>
</section>
