---
import { highlights } from "../data/profile";
---

<section id="highlights" class="scroll-mt-20 border-b border-stone-200">
	<div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
		<h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">Highlights</h2>
		<p class="mt-3 max-w-2xl font-serif text-2xl leading-snug text-stone-900 sm:text-3xl">
			A product, a project and a pull request
		</p>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-3">
			{
				highlights.map((item) => (
					<article class="flex flex-col rounded-2xl border border-stone-200 bg-white p-5 transition-all hover:border-stone-300 hover:shadow-lg hover:shadow-stone-200/60 sm:p-6">
						<p class="text-xs font-medium text-stone-400">{item.kind}</p>
						<h3 class="mt-2 font-serif text-lg font-semibold leading-snug text-stone-900">
							<a
								href={item.url}
								target="_blank"
								rel="noreferrer"
								class="group transition-colors hover:text-emerald-700"
							>
								{item.title}
								<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="ml-1 inline-block h-3.5 w-3.5 align-[-0.1em] text-stone-400 transition-colors group-hover:text-emerald-700">
									<path
										fill-rule="evenodd"
										d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5zm7.25-.75a.75.75 0 01.75-.75h3.5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0V6.56l-5.22 5.22a.75.75 0 11-1.06-1.06l5.22-5.22H12.25a.75.75 0 01-.75-.75z"
										clip-rule="evenodd"
									/>
								</svg>
							</a>
						</h3>
						<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{item.description}</p>
						<a
							href={item.more.href}
							class="group mt-5 self-start text-sm font-medium text-emerald-700 transition-colors hover:text-emerald-800"
						>
							{item.more.label}
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="ml-1 inline-block h-4 w-4 align-[-0.2em] transition-transform group-hover:translate-x-0.5">
								<path
									fill-rule="evenodd"
									d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
									clip-rule="evenodd"
								/>
							</svg>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
