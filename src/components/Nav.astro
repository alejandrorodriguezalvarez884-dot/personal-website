---
import { profile } from "../data/profile";

interface Props {
  /** Home sits on top of a dark hero, so the bar starts transparent and turns solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
  { href: "/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header
	id="site-nav"
	data-mode={overlay ? "overlay" : "solid"}
	class:list={[
		"z-40 border-b border-stone-200/80 bg-stone-50/80 backdrop-blur",
		// Overlay pages need the bar to float *on top of* the hero rather than take
		// layout space above it, so it is fixed there and sticky everywhere else.
		overlay ? "fixed inset-x-0 top-0" : "sticky top-0",
	]}
>
	<nav class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-5 sm:h-16 sm:px-6">
		<a href="/" class="nav-brand font-serif text-base font-semibold tracking-tight text-stone-900 sm:text-lg">
			<span class="sm:hidden">{profile.shortName}</span>
			<span class="hidden sm:inline">{profile.name}</span>
		</a>
		<ul class="flex shrink-0 items-center gap-4 text-sm sm:gap-6">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							class={`nav-link transition-colors hover:text-stone-900 ${
								isActive(link.href) ? "font-medium text-stone-900" : "text-stone-600"
							}`}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	#site-nav {
		transition:
			background-color 0.3s ease,
			border-color 0.3s ease;
	}
	/* Over the hero: no chrome, light text. Swapped back to the default (solid)
	   classes by the script below as soon as the user scrolls past the hero. */
	#site-nav[data-mode="overlay"] {
		background-color: transparent;
		border-color: transparent;
		backdrop-filter: none;
	}
	#site-nav[data-mode="overlay"] .nav-brand {
		color: #fafaf9;
	}
	#site-nav[data-mode="overlay"] .nav-link {
		color: rgba(214, 211, 209, 0.85);
	}
	#site-nav[data-mode="overlay"] .nav-link:hover,
	#site-nav[data-mode="overlay"] .nav-link[aria-current="page"] {
		color: #ffffff;
	}
</style>

<script>
	const nav = document.getElementById("site-nav");

	// Only home renders in overlay mode; everywhere else the bar is solid from the start.
	const hero = document.querySelector("[data-hero]");

	if (nav && hero && nav.dataset.mode === "overlay") {
		// The hero counts as "behind the bar" for as long as any part of it is still
		// below the bar's bottom edge - hence the negative top margin. Cheaper and
		// less jittery than a scroll listener.
		const observer = new IntersectionObserver(
			([entry]) => {
				nav.dataset.mode = entry.isIntersecting ? "overlay" : "solid";
			},
			{ rootMargin: "-56px 0px 0px 0px" },
		);
		observer.observe(hero);
	} else if (nav) {
		nav.dataset.mode = "solid";
	}
</script>
