---
import { profile } from "../data/profile";

const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/80 backdrop-blur">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
		<a href="#" class="font-serif text-lg font-semibold tracking-tight text-stone-900">
			{profile.name}
		</a>
		<ul class="flex items-center gap-6 text-sm text-stone-600">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-stone-900">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
