---
import { profile } from "../data/profile";

const links = [
  { href: "/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/80 backdrop-blur">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
		<a href="/" class="font-serif text-lg font-semibold tracking-tight text-stone-900">
			{profile.name}
		</a>
		<ul class="flex items-center gap-6 text-sm">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class={`transition-colors hover:text-stone-900 ${
								isActive(link.href) ? "font-medium text-stone-900" : "text-stone-600"
							}`}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
