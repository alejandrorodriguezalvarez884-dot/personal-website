---
import "../styles/global.css";
import { profile } from "../data/profile";
import AskAssistant from "../components/AskAssistant.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

// Link previews (Instagram, WhatsApp, LinkedIn, X, Slack...) need absolute URLs.
const siteName = "Alejandro Rodríguez";
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
const ogImageAlt = `${profile.name} · ${profile.role} · Madrid`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0c0a09" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={pageUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
			rel="stylesheet"
		/>
		<script
			data-goatcounter="https://alejandrorodriguez.goatcounter.com/count"
			async
			src="//gc.zgo.at/count.js"></script>
	</head>
	<body class="bg-stone-50 text-stone-800 antialiased selection:bg-stone-800 selection:text-stone-50">
		<slot />
		<AskAssistant />
	</body>
</html>

<style is:global>
	html {
		font-family: "Inter", system-ui, sans-serif;
		scroll-behavior: smooth;
		/* Clears the fixed/sticky nav when jumping to an in-page anchor. */
		scroll-padding-top: 5rem;
		/* Belt and braces against a stray wide child causing sideways scroll on a phone. */
		overflow-x: hidden;
	}
	.font-serif {
		font-family: "Source Serif 4", Georgia, serif;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
